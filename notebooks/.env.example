# Copy this file to notebooks/.env and fill in real values.
# notebooks/.env is gitignored — never commit it.

# Supabase project connection string (Dashboard -> Project Settings -> Database
# -> Connection string -> URI, "Session pooler" mode is fine for notebook use).
# This uses the database password, NOT the service_role API key.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres

# Only needed for cells that call an Edge Function directly (bypassing RLS,
# same as process-sms-inbox/scan-gmail do internally) rather than just reading
# the database. Dashboard -> Project Settings -> API -> service_role (secret).
# NEVER paste this key into a notebook cell, a commit, or a chat message —
# keep it only in this gitignored file.
SUPABASE_URL=https://lxxetltpuuwjtxmeemhx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
