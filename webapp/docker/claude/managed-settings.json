{
  "permissions": {
    "allow": [
      "Edit",
      "Bash(npx playwright test *)",
      "Bash(npx playwright test)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npx tsc *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(e2e-doctor)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(git config *)",
      "Edit(//workspace/webapp/docker/**)",
      "Edit(//workspace/.claude/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_AUTOUPDATER": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  }
}
