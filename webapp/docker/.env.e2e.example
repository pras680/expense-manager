# Copy to webapp/.env.e2e.local (gitignored). Used ONLY by the Docker test
# environment, and docker/e2e.sh refuses to run if it names the same host as
# webapp/.env.local (the live project).
#
# Local Supabase (supabase start; see supabase-edge/local-test/README.md):
#   URL as below; anon key from `supabase status` (the CLI's standard local
#   development key, not a secret).
VITE_SUPABASE_URL=http://host.docker.internal:54321
VITE_SUPABASE_ANON_KEY=
# The account you created through the Register screen on the local backend.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
